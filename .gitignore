# Never commit sensitive data
*.credentials*
*.key
*.pem
*.secret
deploy_key*
.statusline_usage_cache.json
.backup-preferences.json
# Personal, per-machine overrides — Claude Code's own model for "not checked in".
# The sandbox picker's per-launch plugin selection lands here (skills.pl Phase B).
.claude/settings.local.json
# NOTE: .claude/settings.json is deliberately NOT ignored. Claude Code defines it
# as the project file "checked into source control and shared with your team", and
# it carries the butler git-guard's hook registration — which has to be tracked or
# a fresh clone silently runs without the guard. It was ignored until 2026-08-06
# because skills.pl wrote the picker's machine-local selection into it on every
# launch; that write now targets settings.local.json instead.
.claude-plans/
.ccpraxis-local-data/

.claude/backup-metadata.json

.claude/backup-cache/

.claude/scheduled_tasks.lock
.claude/worktrees/

# Transient pre-merge backups created by skills/backup/scripts/ccpraxis-helpers.pl settings-export-merge
*.pre-merge.*

# Machine-specific perl shim generated by host-tools/ccpraxis-install.pl (points
# at the local perl.exe path; never the same across machines)
host-tools/bin/perl.cmd

# Added by claude-sandbox bootstrap
deploy_key

# transient lock written beside a file mutated through bp-blueprint.pl
plugins/blueprint/templates/*.lock

# Per-session continuity registries. These are RUNTIME state, but they live at
# $HOME/.claude/ccpraxis/ -- which is a clone of this repo -- so they surface as
# untracked noise in `git status` there and can be committed by accident. The
# live install is the only place they ever appear; ignoring them costs the clone
# nothing and keeps a promotion's status output honest.
.continuity-active/
.drive-solo-active/
.reporter-active/
