               }
            ],
            "matcher" : "Task|Bash"
         }
      ],
      "PreToolUse" : [
         {
            "hooks" : [
               {
                  "command" : "\"$CLAUDE_PROJECT_DIR\"/plugins/butler/hooks/guard-git-mutations.sh",
