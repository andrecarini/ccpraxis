               }
            ],
            "matcher" : "Bash"
         }
      ],
      "Stop" : [
         {
            "hooks" : [
               {
                  "command" : "\"$CLAUDE_PROJECT_DIR\"/plugins/butler/hooks/guard-subagent-stall.sh",
                  "type" : "command"
               }
            ]
         }
      ]
   }
