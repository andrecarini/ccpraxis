{
   "$schema" : "https://json.schemastore.org/claude-code-settings.json",
   "agentPushNotifEnabled" : true,
   "attribution" : {
      "commit" : "",
      "pr" : ""
   },
   "autoMemoryEnabled" : false,
   "autoScrollEnabled" : false,
   "cleanupPeriodDays" : 180,
   "disableAgentView" : true,
   "disableArtifact" : true,
   "disableClaudeAiConnectors" : true,
   "disableRemoteControl" : true,
   "disableWorkflows" : true,
   "editorMode" : "vim",
   "effortLevel" : "high",
   "enabledPlugins" : {
      "agents-md@builtin" : false,
      "almanac@ccpraxis-local" : true,
      "backpack@ccpraxis-local" : true,
      "blueprint@ccpraxis-local" : true,
      "butler@ccpraxis-local" : true,
      "feature-dev@claude-plugins-official" : true,
      "frontend-design@claude-plugins-official" : true,
      "sandbox@ccpraxis-local" : true,
      "steward@ccpraxis-local" : true,
      "telemetry@builtin" : false
   },
   "env" : {
      "CLAUDE_AUTO_BACKGROUND_TASKS" : "1",
      "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR" : "0",
      "CLAUDE_CODE_DISABLE_ADVISOR_TOOL" : "1",
      "CLAUDE_CODE_DISABLE_FAST_MODE" : "1",
      "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY" : "1",
      "CLAUDE_CODE_ENABLE_AWAY_SUMMARY" : "1",
      "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL" : "true",
      "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION" : "100000",
      "CLAUDE_CODE_NEW_INIT" : "1",
      "CLAUDE_CODE_NO_FLICKER" : "1",
      "CLAUDE_CODE_SCROLL_SPEED" : "3",
      "CLAUDE_CODE_SEND_FEEDBACK" : "0",
      "CLAUDE_CODE_TICKLISH_WHISPER" : "1",
      "CLAUDE_CODE_TODO_REMINDER_MODE" : "off",
      "CLAUDE_CODE_USE_POWERSHELL_TOOL" : "1",
      "DISABLE_AUTOUPDATER" : "1",
      "DISABLE_BUG_COMMAND" : "1",
      "DISABLE_FEEDBACK_COMMAND" : "1",
      "DISABLE_INSTALL_GITHUB_APP_COMMAND" : "1",
      "DISABLE_UPGRADE_COMMAND" : "1",
      "ENABLE_PROMPT_CACHING_1H" : "1",
      "FORCE_AUTOUPDATE_PLUGINS" : "1"
   },
   "extraKnownMarketplaces" : {
      "ccpraxis-local" : {
         "source" : {
            "path" : "C:/Users/André/.claude/ccpraxis/plugins",
            "source" : "directory"
         }
      },
      "notion-plugin-marketplace" : {
         "source" : {
            "repo" : "makenotion/claude-code-notion-plugin",
            "source" : "github"
         }
      }
   },
   "feedbackDrafts" : "off",
   "hooks" : {
      "PreToolUse" : [
         {
            "hooks" : [
               {
                  "command" : "f=\"$HOME/.claude/ccpraxis/scripts/hooks/block-nul-redirect.pl\"; [ -f \"$f\" ] || exit 0; exec perl \"$f\"",
                  "type" : "command"
               }
            ],
            "matcher" : "Bash"
         },
         {
            "hooks" : [
               {
                  "command" : "f=\"$HOME/.claude/ccpraxis/scripts/hooks/block-nonascii-ps1.pl\"; [ -f \"$f\" ] || exit 0; exec perl \"$f\"",
                  "type" : "command"
               }
            ],
            "matcher" : "Edit|Write|MultiEdit|NotebookEdit"
         }
      ],
      "SessionStart" : [
         {
            "hooks" : [
               {
                  "command" : "f=\"$HOME/.claude/ccpraxis/scripts/hooks/reap-orphans-hook.pl\"; [ -f \"$f\" ] || exit 0; exec perl \"$f\"",
                  "type" : "command"
               }
            ]
         }
      ]
   },
   "inputNeededNotifEnabled" : true,
   "modelSettings" : {
      "claude-opus-5-5" : {
         "effortLevel" : "medium"
      },
      "claude-sonnet-5" : {
         "effortLevel" : "medium"
      }
   },
   "permissions" : {
      "allow" : [
         "Read",
         "Skill(blueprint:create)",
         "Skill(blueprint:manage)",
         "Skill(butler:dispatch-fleet)",
         "Skill(butler:drive-solo)",
         "Skill(butler:feedback)",
         "Skill(butler:reporter)",
         "Skill(butler:status)",
         "Skill(steward:audit)",
         "Skill(steward:backup)",
         "Skill(steward:ccpraxis-extend)",
         "Skill(steward:setup-project)",
         "Skill(steward:update)",
         "Skill(steward:usage-audit)",
         "Bash(find *)",
         "Bash(grep *)",
         "Bash(wc *)",
         "Bash(awk *)",
         "Bash(echo *)",
         "Bash(claude --version)",
         "Bash(where claude*)",
         "Bash(which claude*)",
         "Bash(git add *)",
         "Bash(git commit *)",
         "Bash(git rm *)",
         "Bash(perl ~/.claude/ccpraxis/scripts/*)",
         "Bash(perl ~/.claude/ccpraxis/plugins/steward/scripts/*)",
         "Bash(bash ~/.claude/ccpraxis/plugins/steward/scripts/*)",
         "Bash(perl scripts/run-tests.pl *)",
         "Bash(perl -c *)",
         "Bash(git diff *)",
         "Bash(git log *)",
         "Bash(git show *)",
         "Bash(git status *)",
         "Bash(git ls-files *)",
         "Bash(ls *)",
         "Bash(cat *)",
         "Bash(head *)",
         "Bash(tail *)",
         "Bash(sed -n *)",
         "Bash(sha256sum *)",
         "WebFetch",
         "WebSearch"
      ],
      "ask" : [],
      "defaultMode" : "default",
      "deny" : [
         "Read(~/.claude/projects/**/memory/**)",
         "SendFeedback"
      ],
      "disableBypassPermissionsMode" : "disable"
   },
   "promptSuggestionEnabled" : false,
   "remoteControlAtStartup" : false,
   "showClearContextOnPlanAccept" : true,
   "showThinkingSummaries" : true,
   "skillOverrides" : {
      "artifact-capabilities" : "off",
      "artifact-design" : "off",
      "artifact-diagramming" : "off",
      "batch" : "off",
      "claude-api" : "off",
      "code-review" : "off",
      "dataviz" : "off",
      "fewer-permission-prompts" : "off",
      "loop" : "off",
      "run" : "off",
      "run-skill-generator" : "off",
      "security-review" : "off",
      "simplify" : "off",
      "team-onboarding" : "off",
      "verify" : "off"
   },
   "skipAutoPermissionPrompt" : true,
   "statusLine" : {
      "command" : "f=\"$HOME/.claude/ccpraxis/scripts/statusline.pl\"; [ -f \"$f\" ] || exit 0; exec perl \"$f\"",
      "type" : "command"
   },
   "syncClaudeAiSkills" : false,
   "timeFormat" : "24-hour",
   "tui" : "fullscreen",
   "useAutoModeDuringPlan" : true,
   "worktree" : {
      "baseRef" : "fresh"
   }
}
