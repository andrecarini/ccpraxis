#!/bin/bash
# bp-denials -- extensionless shim (Decision 47). All logic lives in
# ../scripts/bp-denials.pl; this only locates it and execs it.
if [ -z "${BASH_VERSION:-}" ]; then exec bash "$0" "$@"; fi

set -e

BIN_DIR=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
SCRIPT="$BIN_DIR/../scripts/bp-denials.pl"

if [ ! -f "$SCRIPT" ]; then
  echo "bp-denials: bp-denials.pl not found."
  exit 1
fi

exec perl "$SCRIPT" "$@"
