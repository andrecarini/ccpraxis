{
   "hooks" : {
      "Stop" : [
         {
            "hooks" : [
               {
                  "timeout" : 15,
                  "type" : "command",
                  "command" : "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-stop.sh\""
               }
            ]
         }
      ],
      "PostToolUse" : [
         {
            "hooks" : [
               {
                  "timeout" : 15,
                  "command" : "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/log-dispatch.sh\"",
                  "type" : "command"
               }
            ],
            "matcher" : "Task"
         }
      ],
      "PreToolUse" : [
         {
            "hooks" : [
               {
                  "command" : "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-shutdown.sh\"",
                  "type" : "command",
                  "timeout" : 15
               },
               {
                  "timeout" : 15,
                  "command" : "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-writes.sh\"",
                  "type" : "command"
               },
               {
                  "timeout" : 15,
                  "type" : "command",
                  "command" : "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/ledger-guard.sh\""
               }
            ],
            "matcher" : "Edit|Write|MultiEdit|NotebookEdit"
         },
         {
            "hooks" : [
               {
                  "type" : "command",
                  "command" : "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-bash.sh\"",
                  "timeout" : 15
               }
            ],
            "matcher" : "Bash"
         },
         {
            "matcher" : "Task",
            "hooks" : [
               {
                  "timeout" : 15,
                  "type" : "command",
                  "command" : "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-shutdown.sh\""
               },
               {
                  "timeout" : 15,
                  "command" : "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/track-dispatch.sh\"",
                  "type" : "command"
               }
            ]
         },
         {
            "hooks" : [
               {
                  "command" : "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/repeat-guard.sh\"",
                  "type" : "command",
                  "timeout" : 15
               },
               {
                  "type" : "command",
                  "command" : "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/wait-shape-guard.sh\"",
                  "timeout" : 15
               }
            ]
         }
      ]
   }
}
