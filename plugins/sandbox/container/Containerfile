FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    ca-certificates \
    build-essential \
    jq \
    unzip \
    openssh-client \
    perl \
    procps \
    socat \
    && rm -rf /var/lib/apt/lists/*

# Cache-busting ARG for the fetch step below (fix-batch step 7, finding F5).
# A plain `RUN curl ...` layer is cached by Buildah/Podman keyed on the
# command TEXT plus preceding layers -- an unchanged instruction is NOT
# re-executed on a routine rebuild, so a cached image would trust a
# GitHub-rotated/revoked host key (this happened in 2023) forever, with none
# of the existing staleness triggers (launcher.pl ~2413-2470: version
# mismatch, container age > 7 days, Containerfile hash drift, ...) ever
# busting THIS layer specifically -- they only prompt a normal, cache-enabled
# rebuild. Fix: reuse the SAME 7-day cadence already driving the "container
# age" staleness check (launcher.pl, `$age_days > 7`) rather than invent a
# new independent timer -- the launcher passes this ARG a value that changes
# roughly weekly (`int(time / (7*86400))`), so the fetch layer's cache key
# changes on that cadence and the keys actually refresh instead of rotting.
ARG P02_SSH_HOST_KEYS_CACHEBUST=0
# === BEGIN p02-ssh-host-keys fetch ===
# The image ships openssh-client but no SSH host keys for any git remote, so
# any ssh clone (e.g. Claude Code's own plugin installer cloning over SSH)
# fails closed with "Host key verification failed" -- there is nothing in
# /etc/ssh/ssh_known_hosts to verify against. Fix: populate it at build time
# from GitHub's own published host-key list at https://api.github.com/meta
# (.ssh_keys[]), fetched over TLS authenticated by the ca-certificates bundle
# already installed above -- no separate secret or pinned blob needed, and
# refetched on every cache-invalidated build rather than vendored once and
# left to rot. VERIFICATION IS STRENGTHENED, NEVER DISABLED: this does not
# weaken or skip host-key checking and does not use an unattended
# trust-on-first-use scan -- it supplies the keys and leaves strict checking ON.
# SCOPE: GitHub only -- no evidence of a non-GitHub ssh consumer in this
# codebase, so extending to another host is future work, not a one-line change.
# ALL THREE GitHub SSH endpoints ARE covered (fix-batch step 7, finding F3),
# via a comma-separated known_hosts pattern list rather than three duplicate
# lines: `github.com` (port 22) plus `ssh.github.com` and
# `[ssh.github.com]:443` (the port-443 workaround for networks that block
# outbound 22). All three present the SAME host keys, so one key line serving
# all three patterns is both correct and 1:1 with the fetched key count.
# Covering only `github.com` would have reproduced the exact reported symptom
# ("No ED25519 host key is known for github.com") for any user on a
# port-22-blocked network -- i.e. precisely the user most likely to need the
# workaround. The oracle's AC1d prefix assertion was amended by driver
# authorisation to require all three patterns: the amendment makes it
# STRICTER, and AC1c's one-line-per-key count is unchanged by construction.
# A failed fetch (no network, rate limit, unexpected JSON shape, or a
# malformed/unsafe ssh_keys entry -- fix-batch step 7, findings F1/F2/F6) must
# fail the BUILD loudly rather than ship an image with zero, incomplete, or
# unsafe host keys, so the whole step is one && chain with no soft-fail.
# GUARDS, in order: (1) curl with bounded timeouts/retries (F4) so a
# black-holed network fails loudly instead of hanging the build forever;
# (2) `[ -s gh-meta.json ]` rejects a 200-with-empty-body response BEFORE it
# reaches jq -e, which -- verified against real jq -- reports success on
# zero-byte input despite its own intent to reject an empty/missing
# ssh_keys (F6); (3) `jq -e length>0` rejects a missing/null/empty ssh_keys
# array; (4) the `jq -r` filter itself now VALIDATES every element before
# writing ANY line: rejects an entry containing an embedded newline/carriage
# return (F2 -- unvalidated raw-string output let one malicious element
# inject extra un-prefixed lines, e.g. a `*`/`@cert-authority *` wildcard
# trusted for every SSH host the container ever contacts, not just
# github.com) and rejects any entry that doesn't match a known key-type
# token followed by a base64 blob with nothing else (F1 -- an empty-string
# element such as `{"ssh_keys":[""]}` previously passed every guard and
# shipped a keyless "github.com " line that looks healthy but verifies
# nothing). The newline check runs BEFORE the shape regex and is a literal
# substring test, not relied on via `^`/`$` anchors, because those anchor to
# LINE boundaries in jq's (oniguruma) regex engine, not string boundaries --
# an anchored shape check alone would not catch a mid-string newline.
# jq's `error()` aborts the WHOLE filter (no partial output) the moment the
# count of validated entries differs from the input count, so a
# partially-bad response is refused entirely rather than silently shipping
# fewer keys -- an filter that merely `select()`ed out bad elements without
# this count comparison would re-create F1 in a quieter form; (5) `[ -s
# ssh_known_hosts ]` catches a write that produced zero bytes; (6) a final
# `grep`-based shape assertion over every written line is redundant with (4)
# by construction but kept as an explicit, cheap belt-and-suspenders check
# per the red-team's own suggested mitigation, so a future refactor of the
# jq filter that silently weakens the validation still fails the build.
# Written 2026-08-14, revised 2026-08-14 (fix-batch step 7).
RUN : "cachebust=${P02_SSH_HOST_KEYS_CACHEBUST}" \
    && curl -fsSL --connect-timeout 10 --max-time 45 --retry 2 --retry-delay 2 --retry-all-errors https://api.github.com/meta -o /tmp/gh-meta.json \
    && [ -s /tmp/gh-meta.json ] \
    && jq -e '(.ssh_keys // []) | length > 0' /tmp/gh-meta.json > /dev/null \
    && jq -r '(.ssh_keys // []) as $all | ($all | map(select((test("\n") or test("\r")) | not)) | map(select(test("^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521) [A-Za-z0-9+/=]+$")))) as $valid | if ($valid | length) != ($all | length) then error("p02: an ssh_keys entry failed key-shape validation") else $valid[] end | "github.com,ssh.github.com,[ssh.github.com]:443 " + .' /tmp/gh-meta.json > /etc/ssh/ssh_known_hosts \
    && [ -s /etc/ssh/ssh_known_hosts ] \
    && ! grep -qvE '^github\.com,ssh\.github\.com,\[ssh\.github\.com\]:443 (ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521) [A-Za-z0-9+/=]+$' /etc/ssh/ssh_known_hosts \
    && rm -f /tmp/gh-meta.json
# === END p02-ssh-host-keys fetch ===

# Container runs as root.
#
# Rationale: this is a rootless-Podman dev sandbox. Container UID 0 (root)
# is mapped to the host user via Podman's user namespace, so:
#   - Files written to bind-mounted /project come out owned by the host
#     user on the host (no chown dance required).
#   - "root" inside the container is not host root — a container escape
#     would land as the unprivileged host user.
#   - The agent gets full power inside (apt-get / npm -g / pip global etc.)
#     without any sudo workaround.
# We do NOT create a non-root user.

# Install Claude Code via native installer (installs to /root/.local/bin)
ARG CLAUDE_VERSION=latest
# --connect-timeout/--max-time/--retry* added fix-batch step 7 (finding F4,
# extended from the p02-ssh-host-keys step to its sibling curl invocations
# per the reviewer's note -- same rationale: a black-holed network must fail
# the build loudly rather than hang it forever). No other behavior changed.
RUN curl -fsSL --connect-timeout 10 --max-time 60 --retry 2 --retry-delay 2 --retry-all-errors https://claude.ai/install.sh | bash -s -- ${CLAUDE_VERSION}
ENV PATH="/root/.local/bin:${PATH}"

# Terminal — enable 24-bit color support (matches host terminal)
ENV TERM=xterm-256color
ENV COLORTERM=truecolor

# Tell Claude Code this is a sandbox so it allows --dangerously-skip-permissions
# even though the container runs as root. Without this, Claude Code refuses to
# start with --dangerously-skip-permissions when uid=0 and the whole "full
# autonomy" model breaks. See anthropics/claude-code#9184.
ENV IS_SANDBOX=1

# Supply chain hardening — env vars take effect whenever runtimes are installed
ENV npm_config_ignore_scripts=true
ENV NODE_OPTIONS="--dns-result-order=ipv4first"

# Node + pnpm toolchain (b38-node-pnpm-toolchain).
#
# Versions are EXACT pins, measured 2026-08-03 against the repo's >=7-day
# supply-chain rule -- do NOT "helpfully" bump to latest/lts without
# re-running that measurement:
#   Node v24.18.1 was 6 days old on 2026-08-03 (too new); v24.18.0 (2026-06-23,
#   41 days old) is the newest ELIGIBLE Active-LTS release. Node 20 is EOL;
#   Node 24 "Krypton" is Active LTS.
#   pnpm 11.19.0 (3d) and 11.18.0/dist-tag latest (5d) were both too new;
#   11.17.0 (2026-07-23, 11 days old) is the newest ELIGIBLE release.
# Installed by tarball (not apt/nodesource) so the version is pinned exactly.
# --connect-timeout/--max-time/--retry* added fix-batch step 7 (finding F4);
# see the identical note above the Claude Code installer RUN step. --max-time
# is larger here (the node tarball is a much bigger download).
RUN curl -sSL --connect-timeout 10 --max-time 180 --retry 2 --retry-delay 3 --retry-all-errors https://nodejs.org/dist/v24.18.0/node-v24.18.0-linux-x64.tar.xz -o /tmp/node.tar.xz \
    && tar -xf /tmp/node.tar.xz -C /tmp \
    && mv /tmp/node-v24.18.0-linux-x64 /opt/node24 \
    && ln -sf /opt/node24/bin/node /usr/local/bin/node \
    && ln -sf /opt/node24/bin/npm /usr/local/bin/npm \
    && rm -f /tmp/node.tar.xz \
    && npm install -g pnpm@11.17.0

# /opt/node24/bin MUST be on PATH. npm derives its global prefix from the REAL
# path of the node binary -- dirname(dirname(realpath(process.execPath))) --
# which resolves through the /usr/local/bin/node symlink to /opt/node24, NOT to
# /usr/local. So `npm install -g <tool>` drops its bin into /opt/node24/bin,
# which nothing else puts on PATH: the two `ln -sf` lines above cover exactly
# node and npm and nothing else.
#
# Measured: the build died at the very next step with `/bin/sh: 1: pnpm: not
# found` immediately after npm reported "added 1 package". The install had
# succeeded; only the lookup failed.
#
# Fixing the CLASS (PATH) rather than the INSTANCE (one more symlink for pnpm)
# is deliberate: every `npm install -g` an agent or a backpack item runs inside
# the container hits the same wall, and would "succeed" and then be unreachable
# -- a silent failure far harder to diagnose than this loud one.
ENV PATH="/opt/node24/bin:${PATH}"

# pnpm supply-chain hardening -- separate from the npm_config_ignore_scripts
# key above (that one governs npm; pnpm reads its own PNPM_CONFIG_* env).
# MINIMUM_RELEASE_AGE is in MINUTES: 10080 = 7 days, matching the >=7-day
# rule above (NOT 10080 days -- that would be a different control entirely).
ENV PNPM_CONFIG_IGNORE_SCRIPTS=true
ENV PNPM_CONFIG_MINIMUM_RELEASE_AGE=10080
# Explicitly false: pnpm's documented default for this key is TRUE, which
# silently SKIPS the minimum-release-age check for any package whose
# registry metadata lacks a `time` field -- an easy, silent bypass of the
# whole age control if left unset. Must be pinned explicitly.
ENV PNPM_CONFIG_MINIMUM_RELEASE_AGE_IGNORE_MISSING_TIME=false
ENV PNPM_CONFIG_MINIMUM_RELEASE_AGE_STRICT=true

# OpenCode worker backend (b34-opencode-worker-runtime).
#
# Version: pin 1.18.7 EXACTLY -- measured 2026-08-03 as the newest release
# >=7 days old (latest 1.18.11 was 2d, 1.18.10 4d, 1.18.9/1.18.8 6d -- all
# too new for the supply-chain rule). Do NOT "helpfully" bump this without
# re-running that measurement.
#
# Package: the PLATFORM package opencode-linux-x64, NOT the "opencode" + "-ai"
# meta-package. That meta-package ships a postinstall AND an optionalDependencies
# fetch for its binary; under PNPM_CONFIG_IGNORE_SCRIPTS=true (kept on, no
# security-posture exception needed -- the free tier needs no credential)
# BOTH fail, producing a broken shim that still reports install success
# ("command -v opencode" passes; "opencode --version" errors). The platform
# package declares no scripts at all, so ignore-scripts installs it cleanly.
#
# Location: /usr/lib + /usr/bin, NOT /usr/local. bp-jail.pl's farm covers
# only /usr/{bin,sbin,lib,lib64} and deliberately excludes /usr/local (and
# /usr/share, /usr/include, /usr/src) to keep the farmed set small -- an
# install under /usr/local is invisible inside a jail (exit 127, "No such
# file or directory"). The symlink target is resolved at BUILD time
# (readlink -f) rather than hardcoding the pnpm virtualStoreDir's hashed
# path, so a future virtualStoreDir layout change cannot dangle it.
RUN mkdir -p /usr/lib/opencode && cd /usr/lib/opencode \
    && echo '{"name":"opencode-host","version":"1.0.0","private":true}' > package.json \
    && PNPM_CONFIG_IGNORE_SCRIPTS=true pnpm add opencode-linux-x64@1.18.7 \
    && ln -sf "$(readlink -f node_modules/opencode-linux-x64/bin/opencode)" /usr/bin/opencode

# Git defaults
RUN git config --global core.autocrlf input \
    && git config --global init.defaultBranch main

WORKDIR /project
# Entrypoint: container/heartbeat.sh (extracted from the former inline one-liner
# so its reap decision is unit-testable — plugins/sandbox/tests/t/08-reap-decision.t).
# It does ONE thing now. It used to also spawn a socat port bridge, removed
# 2026-08-29 (bug report 20260825-235021-5e5c) because a wildcard bind on
# 0.0.0.0:N excludes the loopback bind it existed to serve.
#
# Heartbeat keep-alive. Container survives while /tmp/.launcher-alive was
#      mtime-touched within HB=300s (the host manager `claude-sandbox` refreshes
#      it every 2 min). A 10s startup grace lets the manager land the first touch.
#      If the sentinel goes stale (manager terminal closed / laptop asleep):
#        - no live butler run  -> self-reap within ~5 min (no orphan containers),
#          exactly as before;
#        - a live run (/tmp/.butler-busy fresh OR a live coordinator) -> signal a
#          graceful fleet shutdown (touch each blueprint's runs/.shutdown, the A4
#          gate) and wait GRACE_SHUTDOWN=300s for coordinators to park cleanly,
#          reaping as soon as the run clears or at the grace deadline (B6).
#      The container does NOT watch claude itself — its life is bound to the
#      manager heartbeat, not to any claude process. Multiple (or zero) connector
#      sessions are fine.
# Worker-jail skeleton (b33-worker-jail-isolation, spec section 3.4).
#
# This MUST be baked at image build, and cannot be done at runtime. Measured in
# this container: CAP_MKNOD is absent (CapEff=0x800405fb) so `mknod` is denied,
# and /dev is tmpfs so hardlinking the real device nodes fails EXDEV against
# overlayfs. bp-jail.pl therefore falls back to creating plain EMPTY FILES at
# /dev/{null,zero,random,urandom} inside a jail — which satisfies the oracle
# (nothing in t/80 depends on them behaving like devices) but is NOT functional
# for a real worker: any process that opens /dev/null for redirection, or reads
# /dev/urandom for entropy, will misbehave against an empty regular file.
#
# Baking the nodes here is the only place mknod is available (image build runs
# privileged), so a jail built on a container from THIS image gets real devices
# and bp-jail.pl's fallback never fires.
RUN mkdir -p /opt/bp-jail-skel/dev /opt/bp-jail-skel/etc/ssl /opt/bp-jail-skel/tmp \
    && mknod -m 666 /opt/bp-jail-skel/dev/null    c 1 3 \
    && mknod -m 666 /opt/bp-jail-skel/dev/zero    c 1 5 \
    && mknod -m 444 /opt/bp-jail-skel/dev/random  c 1 8 \
    && mknod -m 444 /opt/bp-jail-skel/dev/urandom c 1 9 \
    && chmod 1777 /opt/bp-jail-skel/tmp \
    && cp -a /etc/nsswitch.conf /etc/hosts /opt/bp-jail-skel/etc/ 2>/dev/null || true \
    && cp -a /etc/ssl/certs /opt/bp-jail-skel/etc/ssl/ 2>/dev/null || true \
    && printf 'root:x:0:0:root:/root:/bin/sh\nbpworker:x:4242:4242:bp jail worker:/work:/bin/sh\n' \
       > /opt/bp-jail-skel/etc/passwd \
    && printf 'root:x:0:\nbpworker:x:4242:\n' > /opt/bp-jail-skel/etc/group
# resolv.conf is deliberately NOT baked: it is generated per-container by the
# runtime, so a build-time copy would pin a stale nameserver. bp-jail.pl copies
# the live /etc/resolv.conf into each jail at create time (DNS is criterion C6).

COPY heartbeat.sh /usr/local/bin/sandbox-heartbeat
RUN chmod +x /usr/local/bin/sandbox-heartbeat
ENTRYPOINT ["/usr/local/bin/sandbox-heartbeat"]
